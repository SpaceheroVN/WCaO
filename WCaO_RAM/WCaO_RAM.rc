#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "app_icon.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WCaO Toolkit"
            VALUE "FileDescription",  "WCaO RAM Manager"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "WCaO_RAM.exe"
            VALUE "OriginalFilename", "WCaO_RAM.exe"
            VALUE "ProductName",      "WCaO RAM Manager"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

